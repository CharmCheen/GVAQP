experiments/**/*.parquet
experiments/**/__pycache__/

# But allow .py, .sh, .md, .yaml, .log
!experiments/**/*.py
!experiments/**/*.sh
!experiments/**/*.md
!experiments/**/*.yaml
!experiments/**/*.yml
!experiments/**/*.log
!experiments/**/*.cfg
!experiments/**/*.txt

