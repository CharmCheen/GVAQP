# =========================
.env
.env.*
*.local.yaml
*.local.yml
*.private.yaml
*.private.yml
secrets/
credentials/

# =========================
# Third-party repositories
# Do not commit cloned external repos.
# Record their commit hashes instead.
# =========================
/refe_repos/

