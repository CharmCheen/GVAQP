{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CASQ event boundary schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "dataset",
    "video_id",
    "event_id",
    "event_type",
    "event_start",
    "event_end",
    "event_midpoint",
    "event_duration",
    "involved_object",
    "ego_relevant",
    "boundary_source",
    "boundary_confidence",
    "label_source",
    "human_adjudicated",
    "original_label",
    "source_annotation_path"
  ],
  "properties": {
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "description": "CASQ-normalized event type, e.g. enter_ego_path, near_collision, collision_or_near_collision_precursor."
    },
    "event_start": {
      "type": [
        "number",
        "null"
      ],
      "description": "Start time in seconds when verified. Null is allowed only for incomplete templates, not final clean event sets."
    },
    "event_end": {
      "type": [
        "number",
        "null"
      ],
      "description": "End time in seconds when verified. Null is allowed only for incomplete templates, not final clean event sets."
    },
    "event_midpoint": {
      "type": [
        "number",
        "null"
      ]
    },
    "event_duration": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "involved_object": {
      "type": "string"
    },
    "ego_relevant": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Boolean when verified; 'unknown' is allowed in source previews."
    },
    "boundary_source": {
      "type": "string",
      "minLength": 1
    },
    "boundary_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "label_source": {
      "type": "string",
      "minLength": 1
    },
    "human_adjudicated": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Boolean when verified; 'unknown' is allowed for externally documented labels until audited."
    },
    "original_label": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "source_annotation_path": {
      "type": "string"
    }
  }
}
