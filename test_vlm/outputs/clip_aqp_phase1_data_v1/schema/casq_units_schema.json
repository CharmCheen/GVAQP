{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CASQ unit/block schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "dataset",
    "video_id",
    "unit_id",
    "start_time",
    "end_time",
    "duration",
    "split",
    "has_event_overlap",
    "matched_event_ids",
    "source_video_path",
    "source_annotation_path"
  ],
  "properties": {
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "start_time": {
      "type": "number",
      "minimum": 0
    },
    "end_time": {
      "type": "number",
      "minimum": 0
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "split": {
      "type": "string",
      "enum": [
        "pilot",
        "diagnostic",
        "certification",
        "gold_eval",
        "train",
        "val",
        "test",
        "unknown"
      ]
    },
    "has_event_overlap": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Boolean when event boundaries are available; 'unknown' allowed for templates."
    },
    "matched_event_ids": {
      "type": [
        "array",
        "string",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "source_video_path": {
      "type": "string"
    },
    "source_annotation_path": {
      "type": "string"
    }
  }
}
